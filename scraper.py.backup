# Main scraping function for 2019 season
def scrape_season_2019():
    base_url = "https://xn----etbqgrg5bs.xn--p1ai"
    season_url = "https://xn----etbqgrg5bs.xn--p1ai/igry-2010-yh/sezon-2019"
    
    # Initialize database
    init_db()
    
